# ============================================================
# BulletTrade 回测环境配置示例
# 复制此文件为 .env 即可用于回测
# ============================================================

# ============ 数据源配置（必需） ============

# 数据源类型 (jqdata, tushare, qmt)
DEFAULT_DATA_PROVIDER=jqdata

# 通用数据缓存目录（各数据源使用 DATA_CACHE_DIR/<provider_name>，留空则禁用磁盘缓存）
DATA_CACHE_DIR=~/.bullet-trade/cache

# JQData（聚宽）配置
# 注册地址: https://www.joinquant.com/
JQDATA_USERNAME=your_token_here    # 手机号
JQDATA_PASSWORD=your_password   # 密码
JQDATA_SERVER=  # 可选：自建接入点
JQDATA_PORT=                   # 可选：端口
# 兼容旧变量：JQDATA_USER/JQDATA_PWD

# Tushare 配置（可选，需要token）
# 注册地址: https://tushare.pro/
# TUSHARE_TOKEN=your_token_here
# TUSHARE_CUSTOM_URL=https://fastapic.stockai888.top
#
# Docker + ClickHouse 热链路（优先读本地库，未命中回退远程；详见 docs/data/DATA_PROVIDER_TUSHARE.md）
# TUSHARE_CLICKHOUSE=true
# TUSHARE_CLICKHOUSE_HOST=127.0.0.1
# TUSHARE_CLICKHOUSE_PORT=8123
# TUSHARE_CLICKHOUSE_USER=default
# TUSHARE_CLICKHOUSE_PASSWORD=
# TUSHARE_CLICKHOUSE_DB=default
# TUSHARE_CLICKHOUSE_CONFIG=./config/tushare_clickhouse.example.yaml
# TUSHARE_CLICKHOUSE_FINAL=false
# TUSHARE_CLICKHOUSE_FAST=true
# TUSHARE_CLICKHOUSE_AUTO_FAST=true

# MiniQMT (可选，本地 QMT 行情)
#QMT_DATA_PATH=C:\国金QMT交易端模拟\userdata_mini
#MINIQMT_AUTO_DOWNLOAD=true
#MINIQMT_MARKET=SH

# ============ 回测默认参数 ============

# 默认初始资金
DEFAULT_INITIAL_CASH=100000

# 默认回测频率 (daily, minute)
DEFAULT_FREQUENCY=daily

# 默认基准
DEFAULT_BENCHMARK=000300.XSHG

# ============ 系统配置 ============

# 日志配置
LOG_DIR=./logs
LOG_LEVEL=INFO

# ============ 通知配置 ============
# 企业微信机器人 KEY，配置后 send_msg 会推送群机器人
MESSAGE_KEY=

# ============ 缓存配置 ============

# 启用缓存（提升性能）
ENABLE_CACHE=true

# ============ 性能优化 ============

# 使用 uvloop（仅 macOS/Linux，提升性能）
USE_UVLOOP=true

# 并发获取数据
CONCURRENT_DATA_FETCH=true

# Portfolio 实时刷新（毫秒），默认 200；若需更高频访问可调小
PORTFOLIO_REFRESH_THROTTLE_MS=200

# ============ 回测建议配置 ============
# 
# 日线回测：
#   DEFAULT_FREQUENCY=daily
#   USE_UVLOOP=true
#
# 分钟回测：
#   DEFAULT_FREQUENCY=minute
#   USE_UVLOOP=true   # 异步模式性能更好
#
# 参数优化：
#   ENABLE_CACHE=true # 必须开启缓存

# 远程 QMT server
QMT_SERVER_HOST=127.0.0.1
QMT_SERVER_PORT=58620
QMT_SERVER_TOKEN=please_change_me
